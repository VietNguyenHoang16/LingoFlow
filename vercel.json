{
  "regions": ["sin1"],
  "buildCommand": "npm run build:web",
  "outputDirectory": "build/web",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/example",
      "destination": "/example_manager.html"
    },
    {
      "source": "/classify",
      "destination": "/classify.html"
    }
  ],
  "functions": {
    "api/lingoflow.js": {
      "maxDuration": 60
    }
  }
}
